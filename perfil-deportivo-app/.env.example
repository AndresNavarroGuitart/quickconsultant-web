# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Pooler de Supabase (puerto 6543), usado por la app en runtime
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexion directa de Supabase (puerto 5432), usada solo por Prisma CLI para migraciones
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Monto/moneda reales de la suscripcion (MercadoPago liquida en ARS: definir
# aca el equivalente vigente a u$s10 segun como se resuelva con la cuenta)
MERCADOPAGO_SUBSCRIPTION_AMOUNT="10"
MERCADOPAGO_SUBSCRIPTION_CURRENCY="ARS"

# URL publica de la app (back_url de MercadoPago, OG images absolutas)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Desactiva el bloqueo por trial vencido/sin suscripción (solo para
# desarrollo). Dejar sin definir, o en "false", en producción.
DISABLE_ACCESS_GATING="false"
